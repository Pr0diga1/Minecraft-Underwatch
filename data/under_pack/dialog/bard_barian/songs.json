        "underlined": true,
        "click_event": {
          "action": "run_command",
          "command": "trigger bard_barian_song set 2"
        }
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Ballad of the Final Stand",
        "extra": [
          {
            "text": "\nBoots march at the gate\n Achilles call seals our fate\n He shall meet us late\n Broken bodies block the door\n We shall fight forever more\n",
            "color": "gray",
            "bold": false,
            "underlined": false,
            "click_event": {
              "action": "run_command",
              "command": "trigger bard_barian_song set 3"

        "text": "Marching Shanty",
        "extra": [
          {
            "text": "\nOne, two out to battle, \n Three, four we herd them like cattle, \n Five, six the armor will rattle, \n Seven, eight, and off to war, \n Nine, ten we win once more.",
            "color": "gray",
            "bold": false,
            "underlined": false,
            "click_event": {
              "action": "run_command",
              "command": "trigger bard_barian_song set 1"
            }
          }
        ],
        "color": "blue",
        "bold": true,
        "underlined": true,
        "click_event": {
          "action": "run_command",
          "command": "trigger bard_barian_song set 1"
        }
      },
      "width": 300
    },
    {
